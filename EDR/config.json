{
    "agent": {
        "id": "ubuntu-juiceshop-vm-01",
        "log_level": "info",
        "heartbeat_interval_seconds": 60
    },
    "platform": "linux",
    "monitoring": {
        "file_integrity": {
            "enabled": true,
            "paths": [
                "/home/james/juice-shop",
                "/etc/passwd",
                "/etc/shadow",
                "/etc/sudoers"
            ]
        },
        "process_monitoring": {
            "enabled": true,
            "processes": [
                {
                    "name": "node",
                    "command_line_contains": "/home/james/juice-shop/build/app.js"
                }
            ]
        },
        "network_monitoring": {
            "enabled": true,
            "network_interface": "ens33",
            "syn_flood_threshold": 30,
            "time_window_seconds": 10,
            "port_scan_threshold": 15,
            "udp_flood_threshold": 150,
            "icmp_flood_threshold": 100
        },
        "juice_shop_monitoring": {
            "enabled": true,
            "log_directory": "/home/james/juice-shop/logs/",
            "log_pattern": "access.log*",
            "error_threshold": 10,
            "error_time_window_minutes": 1
        },
        "ssh_monitoring": {
            "enabled": true,
            "log_path": "/var/log/auth.log",
            "fail_threshold": 5,
            "time_window_minutes": 5
        },
        "shell_history_monitoring": {
            "enabled": true
        },
        "log_sources": [
            "/var/log/auth.log",
            "/var/log/syslog",
            "/home/james/.npm/_logs/",
            "/var/log/apache2/access.log",
            "/var/log/apache2/error.log"
        ]
    },
    "detection_rules": {
        "suspicious_commands": [
            "nc -l",
            "ncat -l",
            "whoami",
            "id",
            "uname -a",
            "cat /etc/passwd"
        ],
        "web_attack_patterns": [
            "SELECT.*FROM",
            "<script>",
            "../",
            "etc/passwd"
        ]
    },
    "output": {
        "type": "file",
        "filepath": "/home/james/MyLogs/",
        "format": "human"
    }
}
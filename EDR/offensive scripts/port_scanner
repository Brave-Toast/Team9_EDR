#!/usr/bin/env python3
# Simple Port Scanner
# For educational purposes only

import socket
import sys
import threading
import time

def scan_port(target_ip, port, results, timeout=3):
    # Try to connect to a specific port
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        result = sock.connect_ex((target_ip, port))
        sock.close()
        
        if result == 0:
            results[port] = "OPEN"
            print(f"Port {port}: OPEN")
        else:
            results[port] = "CLOSED"
            
    except Exception as e:
        results[port] = "ERROR"

def main():
    print("Simple Port Scanner")
    print("")
    
    # Get target from user
    target = input("Enter IP and port to scan: ")
    
    try:
        if ":" in target:
            target_ip, port_str = target.split(":", 1)
            port = int(port_str)
            
            print(f"Scanning {target_ip}:{port}...")
            print("")
            
            # Simple single port scan
            results = {}
            scan_port(target_ip, port, results)
            
            if results.get(port) == "OPEN":
                print(f"SUCCESS: Port {port} is open on {target_ip}")
            else:
                print(f"Port {port} is closed or filtered on {target_ip}")
                
        else:
            # If no port specified, scan common ports
            target_ip = target
            common_ports = [21, 22, 23, 25, 53, 80, 110, 443, 993, 995, 3000, 8080]
            
            print(f"Scanning common ports on {target_ip}...")
            print("")
            
            results = {}
            threads = []
            
            for port in common_ports:
                thread = threading.Thread(target=scan_port, args=(target_ip, port, results))
                threads.append(thread)
                thread.start()
                time.sleep(0.1)  # Small delay between scans
            
            # Wait for all threads to complete
            for thread in threads:
                thread.join()
            
            # Show results
            print("")
            print("=== Scan Results ===")
            open_ports = [port for port, status in results.items() if status == "OPEN"]
            
            if open_ports:
                print(f"Found {len(open_ports)} open ports:")
                for port in sorted(open_ports):
                    print(f"  Port {port}: OPEN")
            else:
                print("No open ports found")
                
    except ValueError:
        print("Invalid format. Use IP:PORT (e.g., 192.168.86.130:3000)")
    except Exception as e:
        print(f"Error: {str(e)}")
    
    print("Scan finished.")

if __name__ == "__main__":
    main()